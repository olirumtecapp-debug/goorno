{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "redirects": [
    {
      "source": "/GoOrNo.apk",
      "destination": "https://raw.githubusercontent.com/olirumtecapp-debug/goorno/main/GoOrNo-v3.3.76.apk",
      "permanent": false
    },
    {
      "source": "/GoOrNo-v3.3.76.apk",
      "destination": "https://raw.githubusercontent.com/olirumtecapp-debug/goorno/main/GoOrNo-v3.3.76.apk",
      "permanent": false
    },
    {
      "source": "/GoOrNo-v76.apk",
      "destination": "https://raw.githubusercontent.com/olirumtecapp-debug/goorno/main/GoOrNo-v3.3.76.apk",
      "permanent": false
    },
    {
      "source": "/download/apk",
      "destination": "https://raw.githubusercontent.com/olirumtecapp-debug/goorno/main/GoOrNo-v3.3.76.apk",
      "permanent": false
    },
    {
      "source": "/download/GoOrNo.apk",
      "destination": "https://raw.githubusercontent.com/olirumtecapp-debug/goorno/main/GoOrNo-v3.3.76.apk",
      "permanent": false
    },
    {
      "source": "/download/GoOrNo-v3.3.76.apk",
      "destination": "https://raw.githubusercontent.com/olirumtecapp-debug/goorno/main/GoOrNo-v3.3.76.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
