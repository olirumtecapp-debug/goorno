<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_notif_container"
    android:padding="12dp">

    <!-- Top Header: Title + App Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_notif_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="R$ 8,60 · 19 min · 5,7 km"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_notif_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="99"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/bg_notif_badge_99" />
    </LinearLayout>

    <!-- 3 Pillars Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <!-- Column 1: R$/Km -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$/Km"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/line_notif_km"
                android:layout_width="32dp"
                android:layout_height="2.5dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:background="#16A34A" />

            <TextView
                android:id="@+id/tv_notif_km"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1,51"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Column 2: R$/Hr -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$/Hr"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/line_notif_hr"
                android:layout_width="32dp"
                android:layout_height="2.5dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:background="#CA8A04" />

            <TextView
                android:id="@+id/tv_notif_hr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="27"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Column 3: Nota -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nota"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/line_notif_rating"
                android:layout_width="32dp"
                android:layout_height="2.5dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:background="#16A34A" />

            <TextView
                android:id="@+id/tv_notif_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5,00"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Address Lines -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tv_notif_origin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Av. Índico, 180"
            android:textColor="#CBD5E1"
            android:textSize="11.5sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_notif_dest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="🏁 Rua Oneda, 445"
            android:textColor="#CBD5E1"
            android:textSize="11.5sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Street View Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="9dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btn_notif_origin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="Embarque"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_notif_action_btn" />

        <TextView
            android:id="@+id/btn_notif_dest"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="Destino"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_notif_action_btn" />
    </LinearLayout>

</LinearLayout>
